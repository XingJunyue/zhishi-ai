<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 应用内更新：下载自己的新版本安装包后交给系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 「从日历导入」：读系统日历里的课程日程 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- 待办到点提醒：通知（第一次打开提醒时才申请）；精确闹钟（USE_EXACT_ALARM / 旧系统 SCHEDULE_EXACT_ALARM）；开机后把提醒重新排上 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Android 13+：装上即有精确闹钟权限（不走应用商店，不受 Play 政策限制）；小米等手机默认不给 SCHEDULE_EXACT_ALARM -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- AI 助手的离线语音输入：按住麦克风说话时录音（第一次用时才申请；声音只在手机上识别，不上传、不保存） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application
        android:name=".ZhishiApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Zhishi">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".CourseWidget4" android:exported="false" android:label="@string/w_course4_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_course4" />
        </receiver>
        <receiver android:name=".CourseWidget2" android:exported="false" android:label="@string/w_course2_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_course2" />
        </receiver>
        <receiver android:name=".TodoWidget4" android:exported="false" android:label="@string/w_todo4_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_todo4" />
        </receiver>
        <receiver android:name=".TodoWidget2" android:exported="false" android:label="@string/w_todo2_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_todo2" />
        </receiver>
        <!-- 待办小部件里可以滑动的列表：桌面通过系统绑定这个服务取每一行 -->
        <service android:name=".TodoWidgetService" android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <!-- 小部件到点重画（下一分钟 / 上下课 / 0 点）；改时间、时区、开机后也重画 -->
        <receiver android:name=".WidgetTick" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".TodoReminder" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
